{
  "name": "stem-mp4",
  "version": "0.5.0",
  "description": "Read and write multi-track Stem MP4 (.stem.mp4) files with karaoke extensions",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./extractor": "./src/extractor.js"
  },
  "bin": {
    "stem-mp4": "./bin/cli.js"
  },
  "scripts": {
    "test": "node --test test/integrity.test.js && node test/extractor.test.js",
    "test:watch": "node --test --watch",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html sh -c 'node --test test/integrity.test.js && node test/extractor.test.js'",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "keywords": [
    "stem-mp4",
    "stems",
    "mp4",
    "m4a",
    "karaoke",
    "audio",
    "multitrack",
    "traktor",
    "ni-stems",
    "ffmpeg",
    "browser",
    "isomorphic",
    "web-audio"
  ],
  "author": "Luis Montes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monteslu/stem-mp4.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^9.0.0"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ]
}
